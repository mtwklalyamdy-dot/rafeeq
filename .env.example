# قاعدة البيانات (إلزامي)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# قائمة عناوين البريد الممنوح لها دور الإدارة على الخادم (لا تغيّر role في قاعدة البيانات)
RAFEEQ_ADMIN_EMAILS=

# Google Gemini — اختياري، يلزم للمساعد والتلخيص وتحويل الصوت
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# SMTP — اختياري، يلزم لإرسال OTP والاستعادة
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# قائمة بريدية إدارية خادمية (تمنح صلاحية الإدارة دون تعديل سجل المستخدم)
RAFEEQ_ADMIN_EMAILS=

# إنشاء أول مدير عبر scripts/create-admin.mjs ثم حذف هذه المتغيرات
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
